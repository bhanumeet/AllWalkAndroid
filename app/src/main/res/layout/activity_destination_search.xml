<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

  <EditText
      android:id="@+id/search_input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_search_field"
      android:hint="Where do you want to go?"
      android:imeOptions="actionSearch"
      android:inputType="textCapWords"
      android:minHeight="52dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:textColor="#1A1A1A"
      android:textColorHint="#8A8F98"
      android:textSize="16sp" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:gravity="center"
      android:orientation="horizontal">

    <ImageButton
        android:id="@+id/search_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_round_dark"
        android:contentDescription="Search"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_search"
        android:stateListAnimator="@null"
        app:backgroundTint="@null" />

    <ImageButton
        android:id="@+id/search_again_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_round_light"
        android:contentDescription="Search again"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_redo"
        android:stateListAnimator="@null"
        app:backgroundTint="@null" />

    <ImageButton
        android:id="@+id/search_settings_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_round_light"
        android:contentDescription="Settings"
        android:padding="14dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings"
        android:stateListAnimator="@null"
        app:backgroundTint="@null" />
  </LinearLayout>

  <TextView
      android:id="@+id/search_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:textColor="#3C4048"
      android:textSize="18sp" />

  <LinearLayout
      android:id="@+id/mic_pad"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="12dp"
      android:layout_weight="1"
      android:background="@drawable/bg_search_field"
      android:clickable="true"
      android:contentDescription="Tap to speak"
      android:focusable="true"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:padding="16dp">

    <ImageView
        android:id="@+id/mic_icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Microphone"
        android:src="@drawable/ic_mic" />

    <TextView
        android:id="@+id/mic_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Tap anywhere to speak"
        android:textColor="#1A1A1A"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/results_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical" />
  </LinearLayout>

  <Button
      android:id="@+id/hear_again_button"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:background="@drawable/bg_button_secondary"
      android:minHeight="48dp"
      android:stateListAnimator="@null"
      android:text="Hear the options again"
      android:textAllCaps="false"
      android:textColor="#1A1A1A"
      android:textSize="16sp"
      android:visibility="gone"
      app:backgroundTint="@null" />

</LinearLayout>
